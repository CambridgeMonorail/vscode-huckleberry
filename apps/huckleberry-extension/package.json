{
  "name": "vscode-copilot-huckleberry",
  "displayName": "Huckleberry Workflow Workbench",
  "version": "0.1.26",
  "description": "A VS Code GitHub Copilot extension for defining and managing engineering workflows",
  "publisher": "CambridgeMonorail",
  "repository": {
    "type": "git",
    "url": "https://github.com/CambridgeMonorail/vscode-huckleberry.git"
  },
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.93.0",
    "node": "^22.0.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "tags": [
    "chat-participant"
  ],
  "activationEvents": [
    "onChatParticipant:huckleberry",
    "onView:huckleberryLoopsView",
    "onView:huckleberryRunsView",
    "onCommand:vscode-copilot-huckleberry.loops.refresh",
    "onCommand:vscode-copilot-huckleberry.runs.refresh",
    "onCommand:vscode-copilot-huckleberry.loops.createStarterTemplates",
    "onCommand:vscode-copilot-huckleberry.debugWelcomeView",
    "onCommand:vscode-copilot-huckleberry.debugTreeViewProperties"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-copilot-huckleberry.loops.refresh",
        "title": "Refresh Loops",
        "category": "Huckleberry",
        "icon": "$(refresh)",
        "description": "Refresh the Loops explorer view"
      },
      {
        "command": "vscode-copilot-huckleberry.runs.refresh",
        "title": "Refresh Runs",
        "category": "Huckleberry",
        "icon": "$(refresh)",
        "description": "Refresh the Runs explorer view"
      },
      {
        "command": "vscode-copilot-huckleberry.loops.createStarterTemplates",
        "title": "Create Starter Templates",
        "category": "Huckleberry",
        "icon": "$(new-file)",
        "description": "Scaffold starter loop definitions under .huckleberry/loops"
      },
      {
        "command": "vscode-copilot-huckleberry.debugWelcomeView",
        "title": "Huckleberry: Debug Welcome View",
        "category": "Huckleberry",
        "description": "Debug why the explorer welcome view is not showing"
      },
      {
        "command": "vscode-copilot-huckleberry.debugTreeViewProperties",
        "title": "Huckleberry: Debug TreeView Properties",
        "category": "Huckleberry",
        "description": "Inspect TreeView properties to troubleshoot welcome view issues"
      }
    ],
    "chatParticipants": [
      {
        "id": "huckleberry",
        "name": "Huckleberry",
        "description": "An assistant that helps manage engineering workflows and project execution",
        "isSticky": false
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "huckleberryWorkbench",
          "title": "Huckleberry",
          "icon": "resources/huckleberry-logo-dark.svg"
        }
      ]
    },
    "views": {
      "huckleberryWorkbench": [
        {
          "id": "huckleberryLoopsView",
          "name": "Loops",
          "type": "tree"
        },
        {
          "id": "huckleberryRunsView",
          "name": "Runs",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscode-copilot-huckleberry.loops.refresh",
          "when": "view == huckleberryLoopsView",
          "group": "navigation"
        },
        {
          "command": "vscode-copilot-huckleberry.loops.createStarterTemplates",
          "when": "view == huckleberryLoopsView",
          "group": "navigation"
        },
        {
          "command": "vscode-copilot-huckleberry.runs.refresh",
          "when": "view == huckleberryRunsView",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "huckleberryLoopsView",
        "contents": "$(repo) No loops found yet.\n\nCreate workflow files under `.huckleberry/loops` to populate this view.\n\n[$(new-file) Create Starter Templates](command:vscode-copilot-huckleberry.loops.createStarterTemplates)\n[$(refresh) Refresh Loops](command:vscode-copilot-huckleberry.loops.refresh)"
      },
      {
        "view": "huckleberryRunsView",
        "contents": "$(history) No runs yet.\n\nRun history and evidence timelines will appear here once loop execution is available.\n\n[$(refresh) Refresh Runs](command:vscode-copilot-huckleberry.runs.refresh)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:edh": "node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.3.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@vscode/chat-extension-utils": "0.0.0-alpha.5",
    "tslib": "^2.6.2",
    "yaml": "^2.9.0"
  }
}
