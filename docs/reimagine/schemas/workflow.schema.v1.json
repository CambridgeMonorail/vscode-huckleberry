{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huckleberry.dev/schemas/workflow.schema.v1.json",
  "title": "huckleberry Workflow v1",
  "description": "Schema skeleton for evidence-driven workflow definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/inputDefinition"
      }
    },
    "execution": {
      "$ref": "#/$defs/executionOptions"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "stop": {
      "$ref": "#/$defs/stopPolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "inputDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "file",
            "enum"
          ]
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "required": {
          "type": "boolean"
        },
        "enumValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "executionOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isolation": {
          "type": "string",
          "enum": [
            "workspace",
            "worktree"
          ],
          "default": "workspace"
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "maxRunAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "backoffSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      }
    },
    "stepBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "retry": {
          "$ref": "#/$defs/retryPolicy"
        }
      }
    },
    "commandStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "command"
          ],
          "properties": {
            "type": {
              "const": "command"
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "capture": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stdout": {
                  "type": "string"
                },
                "stderr": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "agentStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "goal"
          ],
          "properties": {
            "type": {
              "const": "agent"
            },
            "agent": {
              "type": "string"
            },
            "goal": {
              "type": "string",
              "minLength": 1
            },
            "constraints": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "maxFilesChanged": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                },
                "maxTurns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              }
            }
          }
        }
      ]
    },
    "conditionStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "expression",
            "true",
            "false"
          ],
          "properties": {
            "type": {
              "const": "condition"
            },
            "expression": {
              "type": "string"
            },
            "true": {
              "type": "string"
            },
            "false": {
              "type": "string"
            }
          }
        }
      ]
    },
    "approvalStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "approval"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "artifactStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "type",
            "command"
          ],
          "properties": {
            "type": {
              "const": "artifact"
            },
            "command": {
              "type": "string"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "subloopStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "required": [
            "uses"
          ],
          "properties": {
            "type": {
              "const": "subloop"
            },
            "uses": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/commandStep"
        },
        {
          "$ref": "#/$defs/agentStep"
        },
        {
          "$ref": "#/$defs/conditionStep"
        },
        {
          "$ref": "#/$defs/approvalStep"
        },
        {
          "$ref": "#/$defs/artifactStep"
        },
        {
          "$ref": "#/$defs/subloopStep"
        }
      ]
    },
    "stopPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "string"
        },
        "failure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}