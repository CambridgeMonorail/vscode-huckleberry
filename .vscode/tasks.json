{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-extension",
      "type": "shell",
      "command": "pnpm run build:extension",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "watch-extension",
      "type": "shell",
      "command": "pnpm run watch:extension",
      "isBackground": true,
      "group": "build",
      "problemMatcher": "$tsc-watch",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "test-extension",
      "type": "shell",
      "command": "pnpm run test:extension",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "test-extension-watch",
      "type": "shell",
      "command": "pnpm run test:watch",
      "options": {
        "cwd": "${workspaceFolder}/apps/huckleberry-extension"
      },
      "isBackground": true,
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "test-extension-coverage",
      "type": "shell",
      "command": "pnpm run test:coverage",
      "options": {
        "cwd": "${workspaceFolder}/apps/huckleberry-extension"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "lint-affected",
      "type": "shell",
      "command": "pnpm run lint:affected",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "typecheck-affected",
      "type": "shell",
      "command": "pnpm run typecheck:affected",
      "group": "test",
      "problemMatcher": "$tsc"
    },
    {
      "label": "test-affected",
      "type": "shell",
      "command": "pnpm run test:affected",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "build-affected",
      "type": "shell",
      "command": "pnpm run build:affected",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "validate-affected",
      "type": "shell",
      "command": "pnpm run validate:affected",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "package-extension",
      "type": "shell",
      "command": "pnpm run build:package:extension",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
