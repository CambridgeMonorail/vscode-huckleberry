{
  "name": "@vscode-huckleberry/source",
  "version": "0.1.26",
  "license": "MIT",
  "scripts": {
    "build:all": "nx run-many --target=build --all",
    "build:affected": "nx show projects --affected --target=build | grep -q . && nx affected -t build || echo 'No projects to build'",
    "build:extension": "nx build vscode-copilot-huckleberry",
    "build:package:extension": "pnpm run build:extension && pnpm run package:extension",
    "build": "nx build",
    "clean:extension": "nx reset && rm -rf apps/huckleberry-extension/dist",
    "lint:all": "nx run-many --target=lint --all --skip-nx-cache",
    "lint:affected": "nx show projects --affected --target=lint | grep -q . && nx affected -t lint || echo 'No projects to lint'",
    "lint:fix:all": "nx run-many --target=lint --all --skip-nx-cache --fix",
    "lint:fix:affected": "nx show projects --affected --target=lint | grep -q . && nx affected -t lint --fix || echo 'No projects to lint'",
    "package:extension": "cd apps/huckleberry-extension && npx vsce package --no-dependencies",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "start:docs": "cd apps/huckleberry-docs && npx docusaurus start",
    "test:all": "nx run-many --target=test --all",
    "test:affected": "nx show projects --affected --target=test | grep -q . && nx affected -t test || echo 'No projects to test'",
    "test:all:coverage": "nx run-many --target=test --all --configuration=coverage",
    "test:affected:coverage": "nx show projects --affected --target=test | grep -q . && nx affected -t test --configuration=coverage || echo 'No projects to test'",
    "test:extension": "nx test vscode-copilot-huckleberry",
    "typecheck:all": "nx run-many --target=typecheck --all",
    "typecheck:affected": "nx show projects --affected --target=typecheck | grep -q . && nx affected -t typecheck || echo 'No projects to typecheck'",
    "watch:extension": "nx build vscode-copilot-huckleberry --watch",
    "validate": "pnpm run lint:all && pnpm run typecheck:all && pnpm run test:all && pnpm run build:all",
    "validate:affected": "pnpm run lint:affected && pnpm run typecheck:affected && pnpm run test:affected && pnpm run build:affected"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "webpackbar": "^7.0.0"
    }
  },
  "dependencies": {
    "empty": "0.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.29.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@docusaurus/tsconfig": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/react": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc-node/register": "1.12.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.23",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "^20.17.30",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "autoprefixer": "10.4.13",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "23.1.0",
    "postcss": "8.4.38",
    "prettier": "^2.6.2",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.9"
  }
}
